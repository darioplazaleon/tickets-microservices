# Copiar a .env y completar los valores vacíos:  cp .env.example .env
# IMPORTANTE: las passwords de Postgres no deben contener comillas simples (').
#
# Los valores localhost:* de este archivo aplican cuando los servicios corren
# EN EL HOST (desde el IDE). Con `docker compose --profile app up` los hosts
# internos (DB, Kafka, Redis, Keycloak, URLs entre servicios) los fija el
# docker-compose.yml; de acá solo se leen secrets y puertos publicados.

# ── Postgres principal (una instancia, un schema por servicio) ──────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ticketing
# Puerto del host mapeado al 5432 del contenedor (cambiar si 5432 está ocupado)
POSTGRES_PORT=5432
DB_HOST=localhost
# DB_PORT es el que usan los servicios Spring; debe coincidir con POSTGRES_PORT
DB_PORT=5432
DB_NAME=ticketing

# Passwords de los roles por servicio (los crea docker/postgresql/init/01-init.sh)
EVENT_DB_PASSWORD=event_changeme
BOOKING_DB_PASSWORD=booking_changeme
ORDER_DB_PASSWORD=order_changeme
TICKET_DB_PASSWORD=ticket_changeme

# ── Kafka / Zookeeper / Schema Registry / Kafka UI ──────────────────────────
ZOOKEEPER_CLIENT_PORT=2181
ZOOKEEPER_TICK_TIME=2000
KAFKA_BROKER_ID=1
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT,PLAINTEXT_INTERNAL:PLAINTEXT
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://localhost:9092,PLAINTEXT_INTERNAL://kafka-broker:29092
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_CLUSTERS_NAME=local
KAFKA_CLUSTERS_LOCAL_BOOTSTRAP_SERVERS=kafka-broker:29092
DYNAMIC_CONFIG_ENABLED=true
SCHEMA_REGISTRY_HOST_NAME=kafka-schema-registry
SCHEMA_REGISTRY_KAFKASTORE_BOOTSTRAP_SERVERS=PLAINTEXT://kafka-broker:29092
SCHEMA_REGISTRY_LISTENERS=http://0.0.0.0:8081
# Para los servicios Spring corriendo en el host:
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── Keycloak ─────────────────────────────────────────────────────────────────
# DB propia de Keycloak (contenedor keycloak-db)
KC_DB_USER=keycloak
KC_DB_PASSWORD=keycloak_changeme
KC_DB_NAME=keycloak
# Variables que consume el contenedor keycloak
DB_VENDOR=postgres
DB_ADDR=keycloak-db
DB_DATABASE=keycloak
DB_USER=keycloak
DB_PASSWORD=keycloak_changeme
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_changeme
# Variables que consumen los servicios (booking registra usuarios; gateway valida JWT)
KEYCLOAK_URL=http://localhost:8091
KEYCLOAK_REALM=tickets
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_JWKS_URI=http://localhost:8091/realms/tickets/protocol/openid-connect/certs
KEYCLOAK_CLIENT_ID=tickets-api
JWT_PRINCIPAL_ATTRIBUTE=preferred_username

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Stripe (paymentservice) ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── Mail (notificationservice) ───────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ── QR (ticketservice): clave HMAC-SHA256 en Base64 ─────────────────────────
# Generar con: openssl rand -base64 32
QR_SECRET_KEY=

# ── Puertos de los servicios ─────────────────────────────────────────────────
EVENT_SERVICE_PORT=8080
BOOKING_SERVICE_PORT=8081
ORDER_SERVICE_PORT=8082
NOTIFICATION_SERVICE_PORT=8085
TICKET_SERVICE_PORT=8086
PAYMENT_SERVICE_PORT=8087
GATEWAY_PORT=8090
# URLs entre servicios (defaults en los application.yml)
EVENT_SERVICE_URL=http://localhost:8080
BOOKING_SERVICE_URL=http://localhost:8081
ORDER_SERVICE_URL=http://localhost:8082
TICKET_SERVICE_URL=http://localhost:8086
