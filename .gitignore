# IntelliJ IDEA specific files (aplica a todos los subproyectos)
.idea/
*.iml
*.iws
*.ipr

# Gradle specific files
.gradle/
build/
out/
!gradle/wrapper/gradle-wrapper.jar

# Maven specific files
target/
dependency-reduced-pom.xml
releases/
tmp/
mvnw
mvnw.cmd
.settings/
.project
.classpath

# Logs
logs/
*.log

# Secrets viven en .env (ver .env.example); los application.yml se versionan
# con placeholders ${ENV_VAR} y NO deben contener valores sensibles.

# Ignore test results
test-results/
surefire-reports/

# Ignore IDE specific files
.vscode/
*.swp

# Ignore OS generated files
.DS_Store
Thumbs.db

# Ignore coverage reports
coverage/
.jacoco/

# Ignore IntelliJ's workspace files
**/.idea/
**/*.iml

.env

# Datos locales de Postgres/Keycloak montados como bind mounts
volume-data/
**/volume-data/


